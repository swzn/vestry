{
  "name": "@vestry/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Record why code changed, next to the code: immutable, in-repo changesets for humans and AI agents.",
  "license": "MIT",
  "author": "Sajad Wazin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swzn/vestry.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/swzn/vestry/issues"
  },
  "homepage": "https://github.com/swzn/vestry#readme",
  "keywords": [
    "git",
    "git-hooks",
    "cli",
    "ai-agents",
    "changelog",
    "provenance",
    "rationale",
    "developer-tools"
  ],
  "bin": {
    "vestry": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/package-docs.mjs copy && npm run build",
    "postpack": "node ../../scripts/package-docs.mjs clean"
